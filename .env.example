# Meta (Facebook) Marketing API Credentials
# ==========================================
#
# SETUP GUIDE:
#
# 1. Go to https://developers.facebook.com/ and create a Meta Developer account
# 2. Click "Create App" → Choose "Business" type → Name it (e.g., "Lead Tracker Ads Manager")
# 3. In your app dashboard, go to "Add Products" → Add "Marketing API"
# 4. Go to Tools → Graph API Explorer (https://developers.facebook.com/tools/explorer/)
# 5. Select your app from the dropdown
# 6. Click "Generate Access Token" and grant these permissions:
#    - ads_management
#    - ads_read
#    - read_insights
# 7. IMPORTANT: The token from Graph API Explorer expires in ~1 hour.
#    For a long-lived token (60 days):
#    a. Go to your App Settings → Basic → copy App ID and App Secret
#    b. Exchange short-lived token for long-lived:
#       curl -X GET "https://graph.facebook.com/v21.0/oauth/access_token?grant_type=fb_exchange_token&client_id=YOUR_APP_ID&client_secret=YOUR_APP_SECRET&fb_exchange_token=YOUR_SHORT_LIVED_TOKEN"
#    c. For a permanent System User token (recommended):
#       - Go to Business Settings → System Users → Add
#       - Assign the ad account to the system user
#       - Generate a token with ads_management, ads_read, read_insights permissions
#
# 8. Find your Ad Account ID:
#    - Go to https://business.facebook.com/settings/ad-accounts
#    - Copy the numeric ID (e.g., 123456789)
#    - Prefix with "act_" → act_123456789

META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_your_ad_account_id_here
PORT=3000
